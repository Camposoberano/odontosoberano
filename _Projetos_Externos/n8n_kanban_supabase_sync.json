      "id": "8c10d5d5-f8b8-471f-a30a-6dc03e0b309e",
      "name": "Upsert Paciente",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [2224, -224],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "rule": { "interval": [{ "field": "minutes" }] }
