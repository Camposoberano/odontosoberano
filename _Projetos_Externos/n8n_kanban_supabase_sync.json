            { "name": "apikey", "value": "sb_secret_HDOdQPScisYM6LuVnic_Eg_wD2rWEx7" },
            { "name": "Authorization", "value": "Bearer sb_secret_HDOdQPScisYM6LuVnic_Eg_wD2rWEx7" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=representation" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"dados\": $json } }}",
        "options": {}
      },
      "id": "60454701-61c7-48e5-af18-5ea4f61334d7",
      "name": "Supabase: Salvar Agendamento",
