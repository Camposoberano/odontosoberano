    {
      "parameters": {
        "jsCode": "// FIX Bug 1: branch TRUE — paciente existe, monta interação com cliente_id correto\nconst ignorar = $('Ignorar Activity').item.json;\nconst pacienteData = $('Buscar ID do Paciente').item.json;\nconst clienteId = Array.isArray(pacienteData) && pacienteData.length > 0\n  ? pacienteData[0].id\n  : (pacienteData?.id || null);\n\nreturn [{\n  json: {\n    cliente_id: clienteId,\n    tipo: 'mensagem',\n    canal: 'whatsapp',\n    direcao: ignorar.body.message_type === 'incoming' ? 'entrada' : 'saida',\n    conteudo: ignorar.body.content,\n    atendente_id: 'ed10a453-6310-4d4d-ba43-0b8f2a0b3d0e',\n    lida: false,\n    created_at: ignorar.body.created_at\n  }\n}];"
